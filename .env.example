# ===========================================
# My-Brain AI - 환경변수 설정
# ===========================================
# 이 파일을 .env로 복사하여 사용하세요
# cp .env.example .env

# === 환경 구분 ===
ENVIRONMENT=development  # development | production

# === 서버 설정 ===
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# === CORS 설정 ===
# 쉼표로 구분된 허용 도메인 목록
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === AI/ML 설정 ===
# Ollama (Docker 환경에서는 host.docker.internal 사용)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=120

# === Vector DB 설정 ===
CHROMA_DB_PATH=./data/.vector_db
USE_CHROMADB=false  # true: ChromaDB, false: SimpleRAGEngine(인메모리)

# === 데이터 경로 ===
DATA_DIR=./data
COMPANY_DATA_DIR=./data/company
PERSONAL_DATA_DIR=./data/personal
PROJECT_DATA_DIR=./data/project

# === 로깅 설정 ===
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json  # json | text

# === 성능 설정 ===
WORKERS_COUNT=4
REQUEST_TIMEOUT=60
